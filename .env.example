# MET Norway requires a unique User-Agent that identifies the app and provides contact info.
MET_USER_AGENT=WeatherApp/0.2 your-email@example.com

# Frost public observation access needs only the Client ID. Do NOT enter the hidden secret.
FROST_CLIENT_ID=

# Number of geographically distributed active verification stations.
TARGET_STATIONS=50

# Refresh Frost station availability about once per week in unattended mode.
AUTO_DISCOVER_STATIONS=1

# Enable only after authentication and live validation.
EARTH_ENGINE_PROJECT=weatherapp-508323
WEATHERNEXT_ENABLED=0
